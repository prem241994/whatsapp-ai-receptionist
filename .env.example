NODE_ENV=development
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_receptionist
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AUTH_TRUSTED_ORIGINS=http://localhost:3000
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-private-verification-token
META_APP_SECRET=replace-with-meta-app-secret
META_ACCESS_TOKEN=replace-with-meta-access-token
META_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
META_GRAPH_API_VERSION=v22.0
INTERNAL_WORKER_SECRET=replace-with-a-private-worker-secret
RATE_LIMIT_GENERAL_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_SIMULATOR_PER_MINUTE=30
API_BASE_URL=http://localhost:4000
WORKER_INTERVAL_MS=30000
# Optional local OpenAI-compatible intent provider. Keep rules for zero-cost default.
INTENT_PROVIDER=rules
INTENT_LLM_BASE_URL=http://localhost:11434/v1
INTENT_LLM_MODEL=llama3.2
INTENT_LLM_API_KEY=
